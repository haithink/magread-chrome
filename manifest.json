{
  "manifest_version": 3,
  "name": "刊读助手",
  "version": "1.1.1",
  "description": "英文网页文章阅读辅助：LLM 摘要、逐段生词表、双击/选中句解（与刊读桌面版同源能力）",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "刊读助手 · 设置"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
